---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/shared/PageHero.astro";
import MockCard from "../../components/shared/MockCard.astro";
import FeatureGrid from "../../components/shared/FeatureGrid.astro";
import DteSection from "../../components/DteSection.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";

const features = [
	{ icon: "⚡", title: "Factura (01)", desc: "Documento estándar para tus ventas, transmitido y sellado al instante." },
	{ icon: "▤", title: "Crédito Fiscal (03)", desc: "CCF para tus clientes contribuyentes, con crédito fiscal aplicado correctamente." },
	{ icon: "↻", title: "Nota de Crédito (05)", desc: "Anulá o ajustá montos ya facturados sin dolores de cabeza contables." },
	{ icon: "◈", title: "Sujeto Excluido (14)", desc: "Para compras a proveedores no inscritos, con el formato que exige Hacienda." },
	{ icon: "✚", title: "Anulaciones y contingencia", desc: "Cubrimos los casos donde Hacienda no responde, sin detener tu venta." },
	{ icon: "▣", title: "DTE desde el punto de venta", desc: "Cada venta en caja sale con su documento electrónico impreso en el ticket." },
	{ icon: "⚙", title: "Integración nativa al sistema", desc: "El facturador vive dentro de tu sistema — no es un conector externo frágil." },
];

---

<Layout
	title="Facturación Electrónica DTE · CodeFactory"
	description="Factura, Crédito Fiscal, Nota de Crédito, Sujeto Excluido y anulaciones transmitidas al Ministerio de Hacienda en segundos, integradas a tu sistema o punto de venta."
>
	<Header />
	<PageHero
		theme="dark"
		badge="Soluciones · Facturación DTE"
		title="Tu facturación <em>DTE</em> al día con Hacienda"
		description="Emisión, firma y transmisión automática de tus documentos electrónicos al Ministerio de Hacienda, integrada a tu sistema o punto de venta — sin infraestructura propia."
		ctaPrimary={{ text: "Solicitar demo", href: "/#contacto" }}
		ctaSecondary={{ text: "Ver clientes", href: "/#clientes" }}
	>
		<MockCard
			icon="⚡"
			title="dte-transmit.json"
			badgeText="Procesado"
			badgeTone="live"
			floats={[
				{ icon: "⚡", text: "Sello en segundos", style: "top:-18px;right:-24px" },
				{ icon: "✚", text: "Normativa vigente", style: "bottom:-18px;left:-20px" },
			]}
		>
			<div class="dte-json">
				<p>{"{"}</p>
				<p>&nbsp;&nbsp;<span class="j-key">"emisor"</span>: <span class="j-str">"CodeFactory S.A."</span>,</p>
				<p>&nbsp;&nbsp;<span class="j-key">"tipoDte"</span>: <span class="j-str">"01"</span>,</p>
				<p>&nbsp;&nbsp;<span class="j-key">"totalPagar"</span>: <span class="j-num">124.50</span></p>
				<p>{"}"}</p>
			</div>
			<div class="dte-status">
				<span class="dte-status-dot"></span>
				PROCESADO · Sello recibido
			</div>
		</MockCard>
	</PageHero>

	<section class="section">
		<div class="wrap">
			<span class="kicker dark">Facturación DTE</span>
			<h2>Tu facturador, siempre a la normativa vigente</h2>
			<p class="sub">La facturación electrónica en El Salvador cambia, y nosotros la mantenemos al día por vos. Cada actualización del Ministerio de Hacienda se aplica a tu sistema sin que tengás que hacer nada.</p>
			<p class="sub">Sellado en segundos, integrado directo a tu sistema o punto de venta, sin depender de un conector externo.</p>
		</div>
	</section>

	<FeatureGrid kicker="Documentos electrónicos" title="Todo lo que cubre tu facturador" items={features} gray />

	<DteSection />


	<Cta />
	<Footer />
</Layout>

<style>
.dte-json{background:rgba(0,0,0,.25);border-radius:10px;padding:16px;font-family:'SF Mono',Menlo,Consolas,monospace;font-size:12.5px;line-height:1.9;margin-bottom:14px}
.j-key{color:var(--accent)}
.j-str{color:var(--accent-2)}
.j-num{color:#ffb86c}
.dte-status{display:flex;align-items:center;gap:8px;background:rgba(56,224,176,.1);border:1px solid rgba(56,224,176,.3);border-radius:10px;padding:10px 14px;font-size:12.5px;font-weight:700;color:var(--accent-2)}
.dte-status-dot{width:8px;height:8px;border-radius:50%;background:var(--accent-2);flex-shrink:0}


@media (max-width:900px){
  }
@media (max-width:600px){
  }
</style>
