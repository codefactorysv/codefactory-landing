---
// Google Analytics 4.
//
// Solo se carga si PUBLIC_GA_ID esta definida y el build es de produccion:
// asi el sitio no pide nada a Google mientras no este configurado, y las
// visitas de `npm run dev` no ensucian las metricas.
const gaId = import.meta.env.PUBLIC_GA_ID ?? "";
const enabled = Boolean(gaId) && import.meta.env.PROD;
---

{enabled && (
	<>
		<link rel="preconnect" href="https://www.googletagmanager.com" />
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
		<script is:inline define:vars={{ gaId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				window.dataLayer.push(arguments);
			}
			window.gtag = gtag;
			gtag("js", new Date());
			gtag("config", gaId);
		</script>
	</>
)}
