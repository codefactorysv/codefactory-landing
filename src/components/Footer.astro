---
import { site } from "../config/site";

const footerColumns = [
	{
		title: "Soluciones",
		links: [
			{ label: "Implementación Odoo", href: "/soluciones/odoo" },
			{ label: "Facturación electrónica", href: "/soluciones/facturacion-dte" },
			{ label: "Soporte y Hosting", href: "/soluciones/hosting" },
			{ label: "Desarrollo a medida", href: "/soluciones/desarrollo" },
			{ label: "Migraciones Odoo", href: "/soluciones/migraciones" },
		],
	},
	{
		title: "Industrias",
		links: [
			{ label: "Retail y POS", href: "/verticales/retail" },
			{ label: "Talleres", href: "/verticales/talleres" },
			{ label: "Ferreterías", href: "/verticales/ferreterias" },
			{ label: "Mascotas y acuarios", href: "/verticales/mascotas" },
		],
	},
];

const contact = [
	{ label: site.email, href: `mailto:${site.email}` },
	{ label: "WhatsApp", href: site.whatsapp.url },
	{ label: site.phone.display, href: site.phone.href },
	{ label: site.location, href: null },
];

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap">
		<div class="footer-top">
			<div>
				<div class="f-brand">
					<img src="/img/logo-codefactory.png" alt="CodeFactory" />
					CodeFactory
				</div>
				<p>Implementación de Odoo, facturación electrónica DTE y desarrollo de software a la medida para empresas que están digitalizando su operación en El Salvador.</p>
			</div>
			{footerColumns.map((col) => (
				<div>
					<h4>{col.title}</h4>
					<ul>
						{col.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
					</ul>
				</div>
			))}
			<div>
				<h4>Contacto</h4>
				<ul>
					{contact.map((item) => (
						<li>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</li>
					))}
				</ul>
			</div>
		</div>
		<div class="footer-bottom">
			<span>© {year} <strong style="color:#fff">CodeFactory</strong> · Todos los derechos reservados.</span>
			<a href="https://facturacion.codefactory.lat" target="_blank" rel="noopener noreferrer">facturacion.codefactory.lat</a>
		</div>
	</div>
</footer>

<style>
footer{background:#01162f;color:#8fa4c0;font-size:14px}
.footer-top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:48px;padding:76px 0 56px;border-bottom:1px solid var(--dark-line)}
.footer-top h4{color:var(--white);font-size:14px;font-weight:700;margin-bottom:18px;letter-spacing:.02em}
.footer-top ul{list-style:none;display:grid;gap:11px}
.footer-top a:hover{color:var(--accent)}
.footer-bottom a:hover{color:var(--accent)}
.f-brand{display:flex;align-items:center;gap:10px;color:var(--white);font-weight:800;font-size:19px;margin-bottom:16px}
.f-brand img{height:36px;width:auto}
.footer-bottom{display:flex;align-items:center;justify-content:space-between;padding:28px 0;flex-wrap:wrap;gap:14px;font-size:13px}

@media (max-width:900px){
  .footer-top{grid-template-columns:1fr 1fr}
}
@media (max-width:600px){
  .footer-top{grid-template-columns:1fr}
  }
</style>
