---
// Los clientes sin logo se muestran como marca de texto, para que la franja
// siga completa mientras llegan los archivos que faltan.
const clients = [
	{ name: "Acuario Exotic Fantasy", logo: "/img/clientes/cliente-acuario-exotic-fantasy.png", w: 414, h: 240 },
	{ name: "Servi Llantas Súper Marios", logo: "/img/clientes/cliente-servi-llantas-super-marios.png", w: 318, h: 240 },
	{ name: "MundoToys", logo: null },
	{ name: "Ferretería SapoteDulce", logo: null },
];

// El carrusel necesita la lista duplicada para que el bucle no tenga corte visible.
const track = [...clients, ...clients];
---

<section class="clients" id="clientes">
	<div class="wrap head">
		<span class="kicker dark">Empresas que confían en CodeFactory</span>
		<h2>Negocios que operan todos los días con nuestros sistemas</h2>
	</div>
	<div class="marquee">
		<div class="marquee-track">
			{track.map((client, i) => (
				client.logo
					? <img
							src={client.logo}
							alt={client.name}
							width={client.w}
							height={client.h}
							loading="lazy"
							decoding="async"
							aria-hidden={i >= clients.length ? "true" : undefined}
						/>
					: <span class="wordmark" aria-hidden={i >= clients.length ? "true" : undefined}>{client.name}</span>
			))}
		</div>
	</div>
</section>

<style>
.clients{background:var(--gray-bg);padding:84px 0;border-bottom:1px solid var(--gray-line)}
.clients .head{text-align:center;margin-bottom:52px}
.marquee{overflow:hidden;position:relative;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.marquee-track{display:flex;gap:80px;align-items:center;width:max-content;animation:scroll 28s linear infinite}
.marquee:hover .marquee-track{animation-play-state:paused}
@keyframes scroll{to{transform:translateX(-50%)}}
.marquee img{height:120px;width:auto;object-fit:contain;filter:grayscale(1);opacity:.65;transition:filter .25s ease,opacity .25s ease}
.marquee img:hover{filter:none;opacity:1}
.wordmark{white-space:nowrap;font-size:26px;font-weight:800;letter-spacing:-.02em;color:var(--gray-text);opacity:.65;transition:color .25s ease,opacity .25s ease}
.wordmark:hover{color:var(--navy);opacity:1}

@media (prefers-reduced-motion:reduce){
  .marquee-track{animation:none}
}
@media (max-width:600px){
  .marquee img{height:84px}
  .wordmark{font-size:20px}
  .marquee-track{gap:48px}
}
</style>
