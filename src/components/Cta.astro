---
import { site, contactKey } from "../config/site";

const trust = [
	"Diagnóstico inicial sin costo",
	"Respuesta en menos de 24 horas",
	"Soporte local en El Salvador",
];

const interests = [
	"Implementación de Odoo ERP",
	"Facturación electrónica DTE",
	"Desarrollo a la medida",
	"Soporte y hosting",
	"Migración de versión o de sistema",
	"Otro / no estoy seguro",
];
---

<section class="cta" id="contacto">
	<div class="wrap cta-inner">
		<div class="cta-copy">
			<span class="kicker">¿Listo para digitalizar?</span>
			<h2>Hablemos sobre tu próximo proyecto tecnológico.</h2>
			<p>Te acompañamos desde el diagnóstico hasta la puesta en marcha. Contanos qué necesitás y diseñamos la solución correcta para tu negocio.</p>
			<ul class="trust">
				{trust.map((item) => <li>{item}</li>)}
			</ul>
			<div class="direct">
				<span>O si preferís, escribinos directo:</span>
				<div class="direct-links">
					<a href={site.whatsapp.url} target="_blank" rel="noopener noreferrer">WhatsApp {site.phone.display}</a>
					<a href={`mailto:${site.email}`}>{site.email}</a>
				</div>
			</div>
		</div>

		<div class="form-card">
			<form
				id="contactForm"
				novalidate
				data-key={contactKey}
				data-wa={site.whatsapp.number}
			>
				<div class="row">
					<div class="field">
						<label for="cf-nombre">Nombre <span aria-hidden="true">*</span></label>
						<input id="cf-nombre" name="nombre" type="text" autocomplete="name" required />
						<small class="err" data-err-for="nombre"></small>
					</div>
					<div class="field">
						<label for="cf-empresa">Empresa</label>
						<input id="cf-empresa" name="empresa" type="text" autocomplete="organization" />
					</div>
				</div>
				<div class="row">
					<div class="field">
						<label for="cf-correo">Correo <span aria-hidden="true">*</span></label>
						<input id="cf-correo" name="correo" type="email" autocomplete="email" required />
						<small class="err" data-err-for="correo"></small>
					</div>
					<div class="field">
						<label for="cf-telefono">Teléfono / WhatsApp <span aria-hidden="true">*</span></label>
						<input id="cf-telefono" name="telefono" type="tel" inputmode="tel" autocomplete="tel" required />
						<small class="err" data-err-for="telefono"></small>
					</div>
				</div>
				<div class="field">
					<label for="cf-interes">¿Qué necesitás?</label>
					<select id="cf-interes" name="interes">
						{interests.map((option) => <option value={option}>{option}</option>)}
					</select>
				</div>
				<div class="field">
					<label for="cf-mensaje">Contanos brevemente tu caso <span aria-hidden="true">*</span></label>
					<textarea id="cf-mensaje" name="mensaje" rows="4" required></textarea>
					<small class="err" data-err-for="mensaje"></small>
				</div>

				<!-- Trampa anti-spam: invisible para personas, los bots la rellenan. -->
				<div class="hp" aria-hidden="true">
					<label for="cf-web">No llenar este campo</label>
					<input id="cf-web" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<button type="submit" class="btn btn-accent" id="cf-submit">Enviar solicitud</button>
				<p class="status" id="cf-status" role="status" aria-live="polite"></p>
				<p class="privacy">Usamos tus datos únicamente para responder tu consulta.</p>
			</form>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("contactForm") as HTMLFormElement | null;

	if (form) {
		const statusEl = document.getElementById("cf-status") as HTMLElement;
		const submitBtn = document.getElementById("cf-submit") as HTMLButtonElement;
		const key = form.dataset.key ?? "";
		const wa = form.dataset.wa ?? "";

		// Conversion en GA4. Si la analitica no esta configurada, no hace nada.
		const trackLead = (metodo: string) => {
			(window as any).gtag?.("event", "generate_lead", {
				method: metodo,
				interes: String(new FormData(form).get("interes") ?? ""),
			});
		};

		const showError = (name: string, message: string) => {
			const input = form.elements.namedItem(name) as HTMLInputElement | null;
			const slot = form.querySelector<HTMLElement>(`[data-err-for="${name}"]`);
			if (slot) slot.textContent = message;
			input?.setAttribute("aria-invalid", message ? "true" : "false");
		};

		const validate = () => {
			const data = new FormData(form);
			const get = (k: string) => String(data.get(k) ?? "").trim();
			let firstBad: string | null = null;

			const checks: Array<[string, boolean, string]> = [
				["nombre", get("nombre").length >= 2, "Escribí tu nombre."],
				["correo", /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(get("correo")), "Revisá el correo."],
				["telefono", get("telefono").replace(/\D/g, "").length >= 8, "Escribí un teléfono válido."],
				["mensaje", get("mensaje").length >= 10, "Contanos un poco más (mínimo 10 caracteres)."],
			];

			for (const [name, ok, message] of checks) {
				showError(name, ok ? "" : message);
				if (!ok && !firstBad) firstBad = name;
			}

			if (firstBad) {
				(form.elements.namedItem(firstBad) as HTMLElement | null)?.focus();
				return null;
			}
			return { data, get };
		};

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const result = validate();
			if (!result) {
				statusEl.textContent = "Revisá los campos marcados.";
				statusEl.className = "status error";
				return;
			}
			const { data, get } = result;

			// Si un bot rellenó la trampa, fingimos éxito y no enviamos nada.
			if (get("sitio_web")) {
				statusEl.textContent = "¡Gracias! Te contactamos pronto.";
				statusEl.className = "status ok";
				form.reset();
				return;
			}

			const resumen =
				`Hola CodeFactory, soy ${get("nombre")}` +
				(get("empresa") ? ` de ${get("empresa")}` : "") +
				`.\nInterés: ${get("interes")}` +
				`\nCorreo: ${get("correo")}` +
				`\nTeléfono: ${get("telefono")}` +
				`\n\n${get("mensaje")}`;

			// Sin clave configurada, el lead se entrega por WhatsApp para no perderlo.
			if (!key) {
				window.open(`https://wa.me/${wa}?text=${encodeURIComponent(resumen)}`, "_blank", "noopener");
				trackLead("whatsapp");
				statusEl.textContent = "Te abrimos WhatsApp con tu mensaje listo para enviar.";
				statusEl.className = "status ok";
				return;
			}

			submitBtn.disabled = true;
			const originalLabel = submitBtn.textContent;
			submitBtn.textContent = "Enviando…";
			statusEl.textContent = "";
			statusEl.className = "status";

			try {
				const response = await fetch("https://api.web3forms.com/submit", {
					method: "POST",
					headers: { "Content-Type": "application/json", Accept: "application/json" },
					body: JSON.stringify({
						access_key: key,
						subject: `Nuevo lead del sitio: ${get("nombre")}`,
						from_name: "Sitio CodeFactory",
						replyto: get("correo"),
						nombre: get("nombre"),
						empresa: get("empresa") || "—",
						correo: get("correo"),
						telefono: get("telefono"),
						interes: get("interes"),
						mensaje: get("mensaje"),
					}),
				});
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				trackLead("formulario");
				form.reset();
				statusEl.textContent = "¡Gracias! Recibimos tu solicitud y te respondemos en menos de 24 horas.";
				statusEl.className = "status ok";
			} catch {
				const link = `https://wa.me/${wa}?text=${encodeURIComponent(resumen)}`;
				statusEl.innerHTML =
					`No pudimos enviar el formulario. Escribinos por <a href="${link}" target="_blank" rel="noopener noreferrer">WhatsApp</a> y te atendemos igual.`;
				statusEl.className = "status error";
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = originalLabel;
			}
		});
	}
</script>

<style>
.cta{background:var(--navy);color:var(--white);position:relative;overflow:hidden}
.cta::before{content:"";position:absolute;top:-160px;left:50%;transform:translateX(-50%);width:760px;height:760px;border-radius:50%;background:radial-gradient(circle,rgba(0,194,255,.14),transparent 65%);pointer-events:none}
.cta-inner{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;padding:104px 0;position:relative;z-index:1}
.cta h2{max-width:520px}
.cta-copy p{color:var(--dark-text);max-width:480px;margin:18px 0 32px;font-size:17px}

.trust{list-style:none;display:grid;gap:12px;font-size:14.5px;color:var(--dark-text);font-weight:600}
.trust li::before{content:"✓ ";color:var(--accent-2);font-weight:800}

.direct{margin-top:36px;padding-top:28px;border-top:1px solid var(--dark-line)}
.direct span{display:block;font-size:13.5px;color:var(--dark-text);margin-bottom:12px}
.direct-links{display:flex;flex-direction:column;gap:8px;font-size:15px;font-weight:700}
.direct-links a{color:var(--accent)}
.direct-links a:hover{text-decoration:underline;text-underline-offset:3px}

.form-card{background:rgba(255,255,255,.04);border:1px solid var(--dark-line);border-radius:var(--radius);padding:32px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.field{display:flex;flex-direction:column;margin-bottom:16px}
.field label{font-size:13px;font-weight:700;margin-bottom:7px;color:var(--white)}
.field label span{color:var(--accent)}
.field input,.field select,.field textarea{background:rgba(255,255,255,.06);border:1px solid var(--dark-line);border-radius:10px;padding:13px 15px;color:var(--white);font-family:inherit;font-size:15px;outline:none;transition:border-color .18s ease}
.field textarea{resize:vertical;min-height:104px}
.field select{cursor:pointer}
.field select option{background:var(--navy-2);color:var(--white)}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent)}
.field input[aria-invalid="true"],.field textarea[aria-invalid="true"]{border-color:#ff8080}
.err{min-height:0;font-size:12.5px;color:#ff9b9b;font-weight:600}
.err:not(:empty){margin-top:6px}

.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

#cf-submit{width:100%;justify-content:center;margin-top:6px}
#cf-submit:disabled{opacity:.6;cursor:progress;transform:none;box-shadow:none}
.status{font-size:14px;font-weight:600;margin-top:14px}
.status:empty{margin-top:0}
.status.ok{color:var(--accent-2)}
.status.error{color:#ff9b9b}
.status :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:3px}
.privacy{font-size:12px;color:var(--dark-text);margin-top:14px}

@media (max-width:980px){
  .cta-inner{grid-template-columns:1fr;gap:44px;padding:76px 0}
  .cta h2,.cta-copy p{max-width:none}
}
@media (max-width:560px){
  .form-card{padding:24px 20px}
  .row{grid-template-columns:1fr;gap:0}
}
</style>
