---
import { site } from "../config/site";
import Analytics from "../components/Analytics.astro";

interface Props {
	title: string;
	description: string;
	/** Imagen para compartir. Por defecto la del sitio. */
	image?: string;
	/** Paginas como el 404 no deben indexarse. */
	noindex?: boolean;
}

const { title, description, image = site.ogImage, noindex = false } = Astro.props;

// Astro.site viene de `site` en astro.config.mjs: con el trailing slash de
// Astro.url.pathname, new URL() produce siempre la URL absoluta correcta.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// Datos estructurados: ayudan a que Google entienda quienes somos y donde
// estamos, que es lo que pesa en las busquedas locales.
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"@id": `${site.url}/#organizacion`,
	name: site.name,
	url: site.url,
	image: ogImage,
	email: site.email,
	telephone: site.phone.display,
	description:
		"Implementacion de Odoo ERP, facturacion electronica DTE y desarrollo de software a la medida para empresas de El Salvador.",
	address: {
		"@type": "PostalAddress",
		addressLocality: "San Miguel",
		addressCountry: "SV",
	},
	areaServed: { "@type": "Country", name: "El Salvador" },
	sameAs: [site.social.facebook, site.social.instagram],
	knowsAbout: [
		"Odoo ERP",
		"Facturacion electronica DTE",
		"Migraciones Odoo",
		"Hosting Odoo",
		"Desarrollo de software a la medida",
	],
};
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="theme-color" content="#011e41" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonical} />
	{noindex && <meta name="robots" content="noindex, follow" />}

	<!-- Open Graph: es lo que arma la vista previa al compartir por WhatsApp o Facebook. -->
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content={site.name} />
	<meta property="og:locale" content="es_SV" />
	<meta property="og:url" content={canonical} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content={`${site.name} — ${description}`} />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImage} />

	<link rel="icon" href="/img/icons/landing/codefactory.ico" sizes="any">
	<link rel="apple-touch-icon" href="/img/logo-codefactory.png">
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<Analytics />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
	<!-- Sin JS no corre el IntersectionObserver que revela el contenido: lo mostramos igual. -->
	<noscript><style>.reveal{opacity:1 !important;transform:none !important}</style></noscript>
</head>
<body>
	<slot />
	<script>
		import "../scripts/main.ts";
	</script>
</body>
</html>

<style is:global>
:root{
  --navy:#011e41;
  --navy-2:#032a58;
  --navy-3:#0a3a70;
  --accent:#00c2ff;
  --accent-2:#38e0b0;
  --white:#ffffff;
  --gray-bg:#f4f7fb;
  --gray-line:#e4e9f1;
  --gray-text:#5a6b82;
  --dark-line:rgba(255,255,255,.12);
  --dark-text:#a9bcd4;
  --radius:16px;
  --maxw:1200px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;color:var(--navy);background:var(--white);font-size:16px;line-height:1.65}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
h1,h2,h3,h4{line-height:1.15;letter-spacing:-.02em}
h2{font-size:clamp(28px,3.6vw,42px);font-weight:800}
.section{padding:100px 0}
.kicker{display:inline-block;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:16px}
.kicker.dark{color:#0084b8}
.sub{font-size:17.5px;color:var(--gray-text);max-width:640px;margin-top:16px}
.btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:15px;padding:15px 30px;border-radius:10px;transition:all .2s ease;cursor:pointer;border:none}
.btn-accent{background:var(--accent);color:var(--navy)}
.btn-accent:hover{background:#33cfff;transform:translateY(-2px);box-shadow:0 10px 26px rgba(0,194,255,.35)}
.btn-outline{background:transparent;color:var(--white);border:1.5px solid var(--dark-line)}
.btn-outline:hover{border-color:var(--accent);color:var(--accent)}
.btn-navy{background:var(--navy);color:var(--white)}
.btn-navy:hover{background:var(--navy-3);transform:translateY(-2px)}

.reveal{opacity:0;transform:translateY(26px);transition:opacity .65s ease,transform .65s ease}
.reveal.visible{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .reveal{opacity:1;transform:none;transition:none}
  html{scroll-behavior:auto}
}
@media (max-width:600px){
  .section{padding:68px 0}
}
</style>
